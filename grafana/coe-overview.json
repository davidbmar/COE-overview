{
  "uid": "coe-overview",
  "title": "COE Overview",
  "schemaVersion": 42,
  "version": 0,
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-12w",
    "to": "now"
  },
  "tags": [
    "coe",
    "security"
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Postgres datasource",
        "type": "datasource",
        "query": "postgres",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Open events (count)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS value FROM coe_events WHERE coe_review_status IS DISTINCT FROM 'resolved'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Open Critical",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS value FROM coe_events WHERE severity = 'CRITICAL' AND coe_review_status IS DISTINCT FROM 'resolved'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Missing owner",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS value FROM coe_events WHERE owner_email IS NULL AND coe_review_status IS DISTINCT FROM 'resolved'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "SLA breaches pending",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS value FROM coe_events WHERE sla_due_at < now() AND coe_review_status IS DISTINCT FROM 'resolved'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Open by severity",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT severity::text AS metric, count(*) AS value FROM coe_events WHERE coe_review_status IS DISTINCT FROM 'resolved' GROUP BY severity",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Open by source",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT source::text AS metric, count(*) AS value FROM coe_events WHERE coe_review_status IS DISTINCT FROM 'resolved' GROUP BY source",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Top owners by open count",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT owner_email, count(*) AS open_count FROM coe_events WHERE coe_review_status IS DISTINCT FROM 'resolved' AND owner_email IS NOT NULL GROUP BY owner_email ORDER BY open_count DESC LIMIT 20",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "SLA breach risk (within 7 days)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT severity::text AS severity, title, owner_email, sla_due_at, source::text AS source, source_id FROM coe_events WHERE coe_review_status IS DISTINCT FROM 'resolved' AND sla_due_at IS NOT NULL AND sla_due_at <= now() + interval '7 days' ORDER BY sla_due_at",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "sla_due_at"},
            "properties": [{"id": "unit", "value": "dateTimeAsIso"}]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Ingested events per run (last 12 weeks)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT started_at AS time, events_ingested FROM coe_runs WHERE $__timeFilter(started_at) AND status IN ('ok','partial') ORDER BY started_at",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Errors per run (last 12 weeks)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT started_at AS time, coalesce((SELECT count(*) FROM jsonb_object_keys(errors_json)), 0) AS sources_with_errors FROM coe_runs WHERE $__timeFilter(started_at) AND status IN ('ok','partial') ORDER BY started_at",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
